#!/usr/bin/env python3
"""Write one key into the machine-local secrets env via dotenvx --plain.

Value is read from stdin (never argv). Existing keys keep their prior form;
new keys are bare KEY=value, so the secrets loader must enable allexport
around the source (see .zshenv).
"""
from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path

SECRETS = Path.home() / ".ssh" / ".secrets.env"


def main() -> None:
    if len(sys.argv) != 2 or sys.argv[1] in {"-h", "--help"}:
        sys.exit("usage: secrets-set KEY < value")
    key = sys.argv[1]
    if not key or "=" in key or any(c.isspace() for c in key):
        sys.exit(f"invalid KEY: {key!r}")
    value = sys.stdin.read()
    if value.endswith("\n"):
        value = value[:-1]
    dotenvx = shutil.which("dotenvx")
    if not dotenvx:
        sys.exit("dotenvx not found on PATH")
    if not SECRETS.is_file():
        sys.exit(f"missing secrets file: {SECRETS}")
    subprocess.run(
        [dotenvx, "set", "-f", str(SECRETS), "-p", "--plain", "--", key, value],
        check=True,
    )


if __name__ == "__main__":
    main()
