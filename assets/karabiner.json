{
  "global": {
    "ask_for_confirmation_before_quitting": true,
    "check_for_updates_on_startup": false,
    "show_in_menu_bar": false,
    "show_profile_name_in_menu_bar": false
  },
  "profiles": [
    {
      "name": "sunghyun",
      "selected": true,
      "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" },
      "complex_modifications": {
        "parameters": {
          "basic.to_if_alone_timeout_milliseconds": 200,
          "basic.to_if_held_down_threshold_milliseconds": 200
        },
        "rules": [
          {
            "description": "Caps Lock tap = tile maximize; hold = Hyper (variable)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
                "to": [{ "set_variable": { "name": "hyper", "value": 1 } }],
                "to_after_key_up": [{ "set_variable": { "name": "hyper", "value": 0 } }],
                "to_if_alone": [{ "key_code": "m", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              }
            ]
          },
          {
            "description": "Hyper arrows/Enter = tiling",
            "manipulators": [
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "left_arrow", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "left_arrow", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "right_arrow", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "right_arrow", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "up_arrow", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "up_arrow", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "down_arrow", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "down_arrow", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "return_or_enter", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "return_or_enter", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              }
            ]
          },
          {
            "description": "Hyper 1-4 = fourth tiles; 5 = Caps Lock",
            "manipulators": [
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "1", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "1", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "2", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "2", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "3", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "3", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "4", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "4", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "5", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "caps_lock" }]
              }
            ]
          },
          {
            "description": "Hyper letters: IME, tiles, desktop, Mission Control, app opens; Hyper+grave = dark mode",
            "manipulators": [
              {
                "type": "basic",
                "conditions": [
                  { "type": "variable_if", "name": "hyper", "value": 1 },
                  {
                    "type": "input_source_unless",
                    "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.US$" }]
                  }
                ],
                "from": { "key_code": "a", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "spacebar", "modifiers": ["left_control"] }]
              },
              {
                "type": "basic",
                "conditions": [
                  { "type": "variable_if", "name": "hyper", "value": 1 },
                  {
                    "type": "input_source_unless",
                    "input_sources": [{ "input_source_id": "^com\\.apple\\.inputmethod\\.Korean" }]
                  }
                ],
                "from": { "key_code": "b", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "spacebar", "modifiers": ["left_control"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "c", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "c", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "d", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "f13" }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "e", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "up_arrow", "modifiers": ["left_control"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "f", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "up_arrow", "modifiers": ["left_control"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "h", "modifiers": { "optional": ["any"] } },
                "to": [{ "software_function": { "open_application": { "bundle_identifier": "com.apple.mail" } } }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "i", "modifiers": { "optional": ["any"] } },
                "to": [{ "software_function": { "open_application": { "bundle_identifier": "com.colliderli.iina" } } }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "j", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "j", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "k", "modifiers": { "optional": ["any"] } },
                "to": [{ "software_function": { "open_application": { "bundle_identifier": "com.apple.Music" } } }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "l", "modifiers": { "optional": ["any"] } },
                "to": [{ "software_function": { "open_application": { "bundle_identifier": "com.apple.iCal" } } }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "m", "modifiers": { "optional": ["any"] } },
                "to": [{ "software_function": { "open_application": { "bundle_identifier": "com.kakao.KakaoTalkMac" } } }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "n", "modifiers": { "optional": ["any"] } },
                "to": [{ "software_function": { "open_application": { "bundle_identifier": "com.tinyspeck.slackmacgap" } } }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "p", "modifiers": { "optional": ["any"] } },
                "to": [{ "software_function": { "open_application": { "bundle_identifier": "com.apple.Preview" } } }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "r", "modifiers": { "optional": ["any"] } },
                "to": [{ "software_function": { "open_application": { "bundle_identifier": "com.linear" } } }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "v", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "v", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "w", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "w", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              },
              {
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "hyper", "value": 1 }],
                "from": { "key_code": "grave_accent_and_tilde", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "grave_accent_and_tilde", "modifiers": ["left_command", "left_control", "left_option", "left_shift"] }]
              }
            ]
          },
          {
            "description": "Cmd-Shift-V = Spotlight clipboard history (virtual ⌘Space then ⌘4; HID events need no TCC grant)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "v", "modifiers": { "mandatory": ["command", "shift"] } },
                "to": [
                  { "key_code": "spacebar", "modifiers": ["left_command"], "hold_down_milliseconds": 100 },
                  { "key_code": "4", "modifiers": ["left_command"] }
                ]
              }
            ]
          },
          {
            "description": "Left/Right Cmd tap = IME switch via the system ^Space shortcut; hold = Cmd chords. TISSelectInputSource from another process updates the menu extra without switching the focused app's input context (macOS 26/27), so the tap rides the OS's own 'Select the previous input source' hotkey instead; input_source_unless makes the toggle deterministic with exactly two enabled sources, and the 500ms per-manipulator alone-timeout accepts deliberate taps the 200ms global gate silently dropped",
            "manipulators": [
              {
                "type": "basic",
                "parameters": { "basic.to_if_alone_timeout_milliseconds": 500 },
                "conditions": [
                  {
                    "type": "input_source_unless",
                    "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.US$" }]
                  }
                ],
                "from": { "key_code": "left_command", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "left_command", "lazy": true }],
                "to_if_alone": [{ "key_code": "spacebar", "modifiers": ["left_control"] }]
              },
              {
                "type": "basic",
                "parameters": { "basic.to_if_alone_timeout_milliseconds": 500 },
                "conditions": [
                  {
                    "type": "input_source_unless",
                    "input_sources": [{ "input_source_id": "^com\\.apple\\.inputmethod\\.Korean" }]
                  }
                ],
                "from": { "key_code": "right_command", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "right_command", "lazy": true }],
                "to_if_alone": [{ "key_code": "spacebar", "modifiers": ["left_control"] }]
              }
            ]
          },
          {
            "description": "Top row exceptions: bare F4 is a plain F4 and bare F5 is Control-M, fn inverts both (Spotlight, dictation). Every other key, F6 included, is left to Apple's media base state",
            "manipulators": [
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "variable_unless",
                    "name": "system.use_fkeys_as_standard_function_keys",
                    "value": true
                  }
                ],
                "from": { "key_code": "f4", "modifiers": { "mandatory": ["fn"], "optional": ["any"] } },
                "to": [{ "apple_vendor_keyboard_key_code": "spotlight", "modifiers": ["fn"] }]
              },
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "variable_unless",
                    "name": "system.use_fkeys_as_standard_function_keys",
                    "value": true
                  }
                ],
                "from": {
                  "key_code": "f4",
                  "modifiers": { "optional": ["caps_lock", "command", "control", "option", "shift"] }
                },
                "to": [{ "key_code": "f4", "modifiers": ["fn"] }]
              },
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "variable_unless",
                    "name": "system.use_fkeys_as_standard_function_keys",
                    "value": true
                  }
                ],
                "from": { "key_code": "f5", "modifiers": { "mandatory": ["fn"], "optional": ["any"] } },
                "to": [{ "consumer_key_code": "dictation", "modifiers": ["fn"] }]
              },
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "variable_unless",
                    "name": "system.use_fkeys_as_standard_function_keys",
                    "value": true
                  }
                ],
                "from": {
                  "key_code": "f5",
                  "modifiers": { "optional": ["caps_lock", "command", "control", "option", "shift"] }
                },
                "to": [{ "key_code": "m", "modifiers": ["left_control"] }]
              }
            ]
          }
        ]
      }
    }
  ]
}
